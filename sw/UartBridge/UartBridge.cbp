<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Builds with the Makefile (make, make clean); on Windows use the make of MSYS2. -->
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="UartBridge" />
		<Option makefile_is_custom="1" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="all">
				<Option output="bin/Release/UartBridge" prefix_auto="0" extension_auto="1" />
				<Option type="1" />
				<Option compiler="gcc" />
				<MakeCommands>
					<Build command="$make -f $makefile all" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="$make -f $makefile clean" />
					<DistClean command="$make -f $makefile clean" />
					<AskRebuildNeeded command="$make -q -f $makefile all" />
					<SilentBuild command="$make -f $makefile all &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
		</Build>
		<Unit filename="Makefile" />
		<Unit filename="README.md" />
		<Unit filename="UartBridge.cpp" />
		<Unit filename="../../rtl/Uart/IpdbgUart.vhd" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
