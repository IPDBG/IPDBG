<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Builds with the Makefile (make, make clean); on Windows use the make of MSYS2. -->
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="BusAccess" />
		<Option makefile_is_custom="1" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="library">
				<Option output="bin/Release/libipdbg-busaccess" prefix_auto="0" extension_auto="1" />
				<Option type="3" />
				<Option compiler="gcc" />
				<MakeCommands>
					<Build command="$make -f $makefile library" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="$make -f $makefile clean" />
					<DistClean command="$make -f $makefile clean" />
					<AskRebuildNeeded command="$make -q -f $makefile library" />
					<SilentBuild command="$make -f $makefile library &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
			<Target title="test">
				<Option output="bin/Release/test" prefix_auto="0" extension_auto="1" />
				<Option type="1" />
				<Option compiler="gcc" />
				<MakeCommands>
					<Build command="$make -f $makefile test" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="$make -f $makefile clean" />
					<DistClean command="$make -f $makefile clean" />
					<AskRebuildNeeded command="$make -q -f $makefile test" />
					<SilentBuild command="$make -f $makefile test &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
			<Target title="python">
				<Option output="python/_BusAccess" prefix_auto="0" extension_auto="1" />
				<Option type="4" />
				<Option compiler="gcc" />
				<MakeCommands>
					<Build command="$make -f $makefile python" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="$make -C python clean" />
					<DistClean command="$make -C python clean" />
					<AskRebuildNeeded command="$make -q -f $makefile python" />
					<SilentBuild command="$make -f $makefile python &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
			<Target title="octave">
				<Option output="octave/BusAccess" prefix_auto="0" extension_auto="1" />
				<Option type="4" />
				<Option compiler="gcc" />
				<MakeCommands>
					<Build command="$make -f $makefile octave" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="$make -C octave clean" />
					<DistClean command="$make -C octave clean" />
					<AskRebuildNeeded command="$make -q -f $makefile octave" />
					<SilentBuild command="$make -f $makefile octave &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="library;test;python;octave;" />
		</VirtualTargets>
		<Unit filename="../../rtl/BusAccess/AhbMaster.vhd" />
		<Unit filename="../../rtl/BusAccess/ApbMaster.vhd" />
		<Unit filename="../../rtl/BusAccess/AvalonMaster.vhd" />
		<Unit filename="../../rtl/BusAccess/Axi4lMaster.vhd" />
		<Unit filename="../../rtl/BusAccess/BusAccessController.vhd" />
		<Unit filename="../../rtl/BusAccess/BusAccessStatemachine.vhd" />
		<Unit filename="../../rtl/BusAccess/RiscvDtm.vhd" />
		<Unit filename="../../rtl/BusAccess/WbMaster.vhd" />
		<Unit filename="BusAccess.c" />
		<Unit filename="BusAccess.h" />
		<Unit filename="BusAccessCxx.cpp" />
		<Unit filename="BusAccessCxx.h" />
		<Unit filename="BusAccessCxx.i" />
		<Unit filename="BusAccessCxx.tpp" />
		<Unit filename="Makefile" />
		<Unit filename="README.md" />
		<Unit filename="octave/Makefile" />
		<Unit filename="octave/README.md" />
		<Unit filename="python/Makefile" />
		<Unit filename="python/README.md" />
		<Unit filename="test.c" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
