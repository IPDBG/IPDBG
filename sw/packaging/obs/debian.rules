#!/usr/bin/make -f
# SPDX-FileCopyrightText: The IPDBG authors
# SPDX-License-Identifier: MPL-2.0

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

INSTALL_VARS = PREFIX=/usr libdir=/usr/lib/$(DEB_HOST_MULTIARCH) \
	PYTHONDIR=/usr/lib/python3/dist-packages

%:
	dh $@ --with python3

override_dh_auto_build:
	$(MAKE) -C sw all python octave

override_dh_auto_install:
	$(MAKE) -C sw install install-python install-octave $(INSTALL_VARS) DESTDIR=$(CURDIR)/debian/tmp
	# the Octave directory comes from octave-config
	octave-config -p LOCALOCTFILEDIR | sed 's|^/||' > debian/octave-ipdbg.install

override_dh_auto_clean:
	$(MAKE) -C sw clean
	rm -f debian/octave-ipdbg.install

override_dh_auto_test:
